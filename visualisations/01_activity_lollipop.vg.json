{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "transparent",

  "width": "container",
  "height": 380,

  "title": {
    "text": "How Australia Gets Outdoors",
    "subtitle": "Participation in selected outdoor activities, Australia, 2025",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35,
    "dy": -10
  },

  "data": {
    "url": "../data/activity_participation.csv"
  },

  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,

      "sort": [
        "Walking (Recreational)",
        "Bush walking",
        "Running/jogging",
        "Swimming",
        "Cycling",
        "Golf",
        "Surfing",
        "Fishing (recreational)",
        "Canoeing/Kayaking",
        "Ski & snowboard",
        "Mountain biking",
        "Rock climbing/Abseiling/Caving"
      ],

      "axis": {
        "domain": false,
        "ticks": false,

        "labelFont": "Source Sans 3",
        "labelFontSize": 13,
        "labelColor": "#333333",

        "labelPadding": 10,
        "labelLimit": 210
      }
    },

    "x": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Participation Rate (%)",

      "scale": {
        "domain": [0, 55]
      },

      "axis": {
        "grid": false,
        "tickCount": 6,

        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#555555",

        "titleFont": "Source Sans 3",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#333333",
        "titlePadding": 12
      }
    },

    "tooltip": [
      {
        "field": "activity",
        "type": "nominal",
        "title": "Activity"
      },
      {
        "field": "participation_rate",
        "type": "quantitative",
        "title": "Participation Rate (%)",
        "format": ".1f"
      }
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 1.5,
        "color": "#C5C5C5"
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110
      },

      "encoding": {
        "color": {
          "condition": {
            "test": "datum.activity === 'Walking (Recreational)'",
            "value": "#2F6B4F"
          },
          "value": "#8BA99A"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.activity === 'Walking (Recreational)'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,

        "font": "Source Sans 3",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#2F6B4F"
      },

      "encoding": {
        "text": {
          "value": "50.2%"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3"
  }
}