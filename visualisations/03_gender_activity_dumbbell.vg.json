
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "background": "transparent",
  "padding": {
    "left": 20,
    "right": 10,
    "top": 10,
    "bottom": 10
  },
  "title": {
    "text": "Does Gender Shape How Australians Get Outdoors?",
    "subtitle": "Male and female participation in selected activities, Australia, 2025",
    "anchor": "start",
    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,
    "offset": 16
  },
  "data": {
    "url": "data/gender_activity_participation.csv",
    "format": {
      "type": "csv",
      "parse": {
        "male": "number",
        "female": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,
      "sort": [
        "Walking (Recreational)",
        "Bush walking",
        "Swimming",
        "Running/jogging",
        "Cycling",
        "Golf",
        "Surfing",
        "Canoeing/Kayaking"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFont": "Source Sans 3",
        "labelFontSize": 13,
        "labelColor": "#333333",
        "labelPadding": 10,
        "labelLimit": 180,
        "labelAlign": "right"
      }
    },
    "x": {
      "type": "quantitative",
      "scale": {
        "domain": [0, 65],
        "nice": false
      },
      "axis": {
        "grid": false,
        "values": [0, 10, 20, 30, 40, 50, 60],
        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#555555",
        "title": "Participation Rate (%)",
        "titleFont": "Source Sans 3",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#333333",
        "titlePadding": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#C5C5C5"
      },
      "encoding": {
        "x": {
          "field": "male"
        },
        "x2": {
          "field": "female"
        }
      }
    },
    {
      "transform": [
        {
          "fold": ["male", "female"],
          "as": ["gender", "participation_rate"]
        },
        {
          "calculate": "datum.gender === 'male' ? 'Male' : 'Female'",
          "as": "Gender"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": ["activity", "Gender"]
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180
      },
      "encoding": {
        "x": {
          "field": "participation_rate"
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#4C78A8", "#E78AC3"]
          },
          "legend": {
            "title": "Gender",
            "orient": "right",
            "direction": "vertical",
            "symbolType": "circle",
            "symbolSize": 180,
            "labelFont": "Source Sans 3",
            "labelFontSize": 14,
            "labelColor": "#333333",
            "titleFont": "Source Sans 3",
            "titleFontSize": 16,
            "titleFontWeight": 600,
            "titleColor": "#333333",
            "titlePadding": 12,
            "offset": 25,
            "padding": 10
          }
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "value": "#333333",
            "empty": false
          },
          "value": null
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "value": 2,
            "empty": false
          },
          "value": 0
        },
        "size": {
          "condition": {
            "param": "hover",
            "value": 240,
            "empty": false
          },
          "value": 180
        },
        "tooltip": [
          {
            "field": "activity",
            "type": "nominal",
            "title": "Activity"
          },
          {
            "field": "Gender",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "participation_rate",
            "type": "quantitative",
            "title": "Participation Rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.activity === 'Walking (Recreational)'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "color": "#222222",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "male"
        },
        "x2": {
          "field": "female"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.activity === 'Walking (Recreational)'"
        },
        {
          "calculate": "format(abs(datum.female - datum.male), '.1f') + ' pp gap'",
          "as": "gap_label"
        },
        {
          "calculate": "(datum.male + datum.female) / 2",
          "as": "gap_midpoint"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -12,
        "font": "Source Sans 3",
        "fontSize": 16,
        "fontWeight": 700,
        "color": "#222222"
      },
      "encoding": {
        "x": {
          "field": "gap_midpoint"
        },
        "text": {
          "field": "gap_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3"
  }
}
