{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 320,

  "background": "transparent",

  "padding": {
    "left": 0,
    "right": 10,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "Does Gender Shape How Australians Get Outdoors?",
    "subtitle": "Male and female participation in selected activities, Australia, 2025",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35
  },

  "data": {
    "url": "../data/gender_activity_participation.csv"
  },

  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,

      "sort": [
        "Walking (Recreational)",
        "Bush walking",
        "Swimming",
        "Running/jogging",
        "Cycling",
        "Golf",
        "Surfing",
        "Canoeing/Kayaking"
      ],

      "axis": {
        "domain": false,
        "ticks": false,

        "labelFont": "Source Sans 3",
        "labelFontSize": 13,
        "labelColor": "#333333",

        "labelPadding": 10,
        "labelLimit": 220
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#C5C5C5"
      },

      "encoding": {
        "x": {
          "field": "male",
          "type": "quantitative",
          "title": "Participation Rate (%)",

          "scale": {
            "domain": [0, 60]
          },

          "axis": {
            "grid": false,
            "tickCount": 7,

            "labelFont": "Source Sans 3",
            "labelFontSize": 12,
            "labelColor": "#555555",

            "titleFont": "Source Sans 3",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#333333",

            "titlePadding": 12
          }
        },

        "x2": {
          "field": "female"
        }
      }
    },

    {
      "transform": [
        {
          "fold": [
            "male",
            "female"
          ],
          "as": [
            "gender",
            "participation_rate"
          ]
        },
        {
          "calculate": "datum.gender === 'male' ? 'Male' : 'Female'",
          "as": "Gender"
        }
      ],

      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "activity",
              "Gender"
            ]
          }
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 130
      },

      "encoding": {
        "x": {
          "field": "participation_rate",
          "type": "quantitative"
        },

        "color": {
          "field": "Gender",
          "type": "nominal",

          "scale": {
            "domain": [
              "Male",
              "Female"
            ],
            "range": [
              "#4C78A8",
              "#E78AC3"
            ]
          },

          "legend": {
            "title": "Gender",
            "orient": "right",
            "direction": "vertical",

            "symbolType": "circle",
            "symbolSize": 100,

            "labelFont": "Source Sans 3",
            "labelFontSize": 13,
            "labelColor": "#333333",

            "titleFont": "Source Sans 3",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#333333",

            "offset": 25,
            "padding": 10
          }
        },

        "stroke": {
          "condition": {
            "param": "hover",
            "value": "#333333"
          },
          "value": null
        },

        "strokeWidth": {
          "condition": {
            "param": "hover",
            "value": 2
          },
          "value": 0
        },

        "size": {
          "condition": {
            "param": "hover",
            "value": 190
          },
          "value": 130
        },

        "tooltip": [
          {
            "field": "activity",
            "type": "nominal",
            "title": "Activity"
          },
          {
            "field": "Gender",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "participation_rate",
            "type": "quantitative",
            "title": "Participation Rate (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3"
  }
}