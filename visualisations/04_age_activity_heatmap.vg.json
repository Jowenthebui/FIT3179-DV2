{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 360,

  "background": "transparent",

  "title": {
    "text": "Who Gets Outdoors?",
    "subtitle": "Outdoor participation patterns shift across age groups, 2025",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16
  },

  "data": {
    "url": "../data/age_activity_participation.csv"
  },

  "params": [
    {
      "name": "cellHover",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout",
        "fields": [
          "activity",
          "age_group"
        ]
      }
    }
  ],

  "mark": {
    "type": "rect"
  },

  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age Group",

      "sort": [
        "15-17",
        "18-24",
        "25-34",
        "35-44",
        "45-54",
        "55-64",
        "65+"
      ],

      "scale": {
        "paddingInner": 0.02,
        "paddingOuter": 0
      },

      "axis": {
        "labelAngle": 0,

        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#555555",

        "titleFont": "Source Sans 3",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#333333",

        "titlePadding": 12
      }
    },

    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,

      "sort": [
        "Walking (Recreational)",
        "Running/jogging",
        "Bush walking",
        "Swimming",
        "Cycling",
        "Golf",
        "Surfing",
        "Canoeing/Kayaking"
      ],

      "scale": {
        "paddingInner": 0.02,
        "paddingOuter": 0
      },

      "axis": {
        "labelFont": "Source Sans 3",
        "labelFontSize": 13,
        "labelColor": "#333333",

        "labelPadding": 10,

        "ticks": false,
        "domain": false
      }
    },

    "color": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Participation Rate (%)",

      "scale": {
        "scheme": "yellowgreenblue",
        "domain": [0, 66]
      },

      "legend": {
        "titleFont": "Source Sans 3",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#333333",

        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#555555"
      }
    },

    "stroke": {
      "condition": {
        "param": "cellHover",
        "empty": false,
        "value": "#222222"
      },
      "value": null
    },

    "strokeWidth": {
      "condition": {
        "param": "cellHover",
        "empty": false,
        "value": 3
      },
      "value": 0
    },

    "tooltip": [
      {
        "field": "activity",
        "type": "nominal",
        "title": "Activity"
      },
      {
        "field": "age_group",
        "type": "ordinal",
        "title": "Age Group"
      },
      {
        "field": "participation_rate",
        "type": "quantitative",
        "title": "Participation Rate (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3"
  }
}