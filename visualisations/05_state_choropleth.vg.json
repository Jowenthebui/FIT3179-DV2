{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 600,
  "height": 430,

  "title": {
    "text": "One Country, Different Ways to Get Outside",
    "subtitle": "Explore how outdoor participation varies across Australian states and territories, 2025",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },

  "params": [
    {
      "name": "activity_selection",
      "value": "Walking (Recreational)",
      "bind": {
        "input": "select",
        "name": "Choose activity: ",
        "options": [
          "Walking (Recreational)",
          "Bush walking",
          "Running/jogging",
          "Swimming",
          "Cycling",
          "Golf",
          "Surfing",
          "Canoeing/Kayaking"
        ]
      }
    }
  ],

  "data": {
    "url": "../data/australia_states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "../data/state_activity_participation.csv"
        },
        "key": "state",
        "fields": [
          "state_code",
          "Walking (Recreational)",
          "Bush walking",
          "Running/jogging",
          "Swimming",
          "Cycling",
          "Golf",
          "Surfing",
          "Canoeing/Kayaking"
        ]
      }
    },
    {
      "calculate": "datum[activity_selection]",
      "as": "participation_rate"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.5
  },

  "encoding": {
    "color": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Participation Rate (%)",
      "scale": {
        "scheme": "yellowgreenblue"
      },
      "legend": {
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },

    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State/Territory"
      },
      {
        "field": "participation_rate",
        "type": "quantitative",
        "title": "Participation Rate (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}