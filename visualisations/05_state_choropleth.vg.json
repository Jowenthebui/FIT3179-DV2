{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 570,

  "background": "transparent",

  "padding": {
    "left": 0,
    "right": 20,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "One Country, Different Ways to Get Outside",
    "subtitle": "Explore how outdoor participation varies across Australian states and territories, 2025",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35,
    "dy": -10
  },

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 780,
    "translate": [470, 300]
  },

  "params": [
    {
      "name": "ActivitySelection",
      "value": "Walking (Recreational)",

      "bind": {
        "input": "select",
        "name": "Choose activity: ",

        "options": [
          "Walking (Recreational)",
          "Bush walking",
          "Running/jogging",
          "Swimming",
          "Cycling",
          "Golf",
          "Surfing",
          "Canoeing/Kayaking"
        ]
      }
    }
  ],

  "data": {
    "url": "../data/australia_states.geojson",

    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",

      "from": {
        "data": {
          "url": "../data/state_activity_participation.csv"
        },

        "key": "state",

        "fields": [
          "state_code",
          "Walking (Recreational)",
          "Bush walking",
          "Running/jogging",
          "Swimming",
          "Cycling",
          "Golf",
          "Surfing",
          "Canoeing/Kayaking"
        ]
      }
    },

    {
      "calculate": "ActivitySelection == 'Walking (Recreational)' ? datum['Walking (Recreational)'] : ActivitySelection == 'Bush walking' ? datum['Bush walking'] : ActivitySelection == 'Running/jogging' ? datum['Running/jogging'] : ActivitySelection == 'Swimming' ? datum['Swimming'] : ActivitySelection == 'Cycling' ? datum['Cycling'] : ActivitySelection == 'Golf' ? datum['Golf'] : ActivitySelection == 'Surfing' ? datum['Surfing'] : datum['Canoeing/Kayaking']",
      "as": "Participation"
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "#FBFAF4",
    "strokeWidth": 1.5
  },

  "encoding": {
    "color": {
      "field": "Participation",
      "type": "quantitative",

      "title": "Participation (%)",

      "scale": {
        "range": [
          "#F2E8A2",
          "#C9D98B",
          "#8DB77A",
          "#4F7D5B",
          "#244B36"
        ]
      },

      "legend": {
        "orient": "right",
        "direction": "vertical",

        "gradientLength": 220,
        "gradientThickness": 14,

        "offset": 24,

        "titleFont": "Source Sans 3",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#333333",
        "titlePadding": 10,

        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#555555",
        "labelOffset": 6
      }
    },

    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / Territory"
      },

      {
        "field": "Participation",
        "type": "quantitative",
        "title": "Participation Rate (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3",

    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  }
}