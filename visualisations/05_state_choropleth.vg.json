{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 480,

  "background": "#FFFFFF",

  "title": {
    "text": "One Country, Different Ways to Get Outside",
    "subtitle": "Explore how outdoor participation varies across Australian states and territories, 2025",
    "anchor": "start",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8
  },

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 580,
    "translate": [280, 250]
  },

  "params": [
    {
      "name": "ActivitySelection",
      "value": "Walking (Recreational)",
      "bind": {
        "input": "select",
        "name": "Choose activity: ",
        "options": [
          "Walking (Recreational)",
          "Bush walking",
          "Running/jogging",
          "Swimming",
          "Cycling",
          "Golf",
          "Surfing",
          "Canoeing/Kayaking"
        ]
      }
    }
  ],

  "data": {
    "url": "data/australia_states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/state_activity_participation.csv"
        },
        "key": "state",
        "fields": [
          "state_code",
          "Walking (Recreational)",
          "Bush walking",
          "Running/jogging",
          "Swimming",
          "Cycling",
          "Golf",
          "Surfing",
          "Canoeing/Kayaking"
        ]
      }
    },
    {
      "calculate": "ActivitySelection == 'Walking (Recreational)' ? datum['Walking (Recreational)'] : ActivitySelection == 'Bush walking' ? datum['Bush walking'] : ActivitySelection == 'Running/jogging' ? datum['Running/jogging'] : ActivitySelection == 'Swimming' ? datum['Swimming'] : ActivitySelection == 'Cycling' ? datum['Cycling'] : ActivitySelection == 'Golf' ? datum['Golf'] : ActivitySelection == 'Surfing' ? datum['Surfing'] : datum['Canoeing/Kayaking']",
      "as": "Participation"
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 1.5
  },

  "encoding": {
    "color": {
      "field": "Participation",
      "type": "quantitative",
      "title": "Participation Rate (%)",
      "scale": {
        "scheme": "yellowgreenblue"
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "gradientLength": 190,
        "gradientThickness": 15,
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titleColor": "#333333",
        "titlePadding": 10,
        "labelFontSize": 11,
        "labelColor": "#555555",
        "labelOffset": 6,
        "offset": 20
      }
    },

    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "Participation",
        "type": "quantitative",
        "title": "Participation (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Arial"
  }
}