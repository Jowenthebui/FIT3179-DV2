{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 760,
  "height": 380,

  "background": "#FFFFFF",

  "title": {
    "text": "Different States, Different Ways to Get Outside",
    "subtitle": "Walking dominates nationwide, while other outdoor activities reveal stronger regional differences",
    "anchor": "start",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8
  },

  "data": {
    "url": "data/state_activity_participation.csv"
  },

  "transform": [
    {
      "fold": [
        "Walking (Recreational)",
        "Bush walking",
        "Running/jogging",
        "Swimming",
        "Cycling",
        "Golf",
        "Surfing",
        "Canoeing/Kayaking"
      ],
      "as": [
        "Activity",
        "Participation"
      ]
    },
    {
      "calculate": "datum.Activity == 'Walking (Recreational)' ? 'Walking' : datum.Activity == 'Running/jogging' ? 'Running' : datum.Activity == 'Canoeing/Kayaking' ? 'Canoeing / Kayaking' : datum.Activity",
      "as": "ActivityLabel"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2,
        "cornerRadius": 2
      },

      "encoding": {
        "x": {
          "field": "ActivityLabel",
          "type": "nominal",
          "title": null,
          "sort": [
            "Walking",
            "Bush walking",
            "Running",
            "Swimming",
            "Cycling",
            "Golf",
            "Surfing",
            "Canoeing / Kayaking"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelColor": "#333333",
            "labelPadding": 8,
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "state_code",
          "type": "nominal",
          "title": null,
          "sort": [
            "ACT",
            "NSW",
            "NT",
            "QLD",
            "SA",
            "TAS",
            "VIC",
            "WA"
          ],
          "axis": {
            "labelFontSize": 12,
            "labelColor": "#333333",
            "labelPadding": 8,
            "ticks": false,
            "domain": false
          }
        },

        "color": {
          "field": "Participation",
          "type": "quantitative",
          "title": "Participation (%)",

          "scale": {
            "domain": [0, 60],
            "scheme": "greens"
          },

          "legend": {
            "title": "Participation (%)",
            "orient": "right",
            "direction": "vertical",

            "gradientLength": 250,
            "gradientThickness": 16,

            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "titleColor": "#333333",
            "titlePadding": 10,

            "labelFontSize": 11,
            "labelColor": "#555555",
            "labelOffset": 6,

            "values": [
              0,
              10,
              20,
              30,
              40,
              50,
              60
            ],

            "offset": 30
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "ActivityLabel",
            "type": "nominal",
            "title": "Activity"
          },
          {
            "field": "Participation",
            "type": "quantitative",
            "title": "Participation (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },

      "encoding": {
        "x": {
          "field": "ActivityLabel",
          "type": "nominal",
          "sort": [
            "Walking",
            "Bush walking",
            "Running",
            "Swimming",
            "Cycling",
            "Golf",
            "Surfing",
            "Canoeing / Kayaking"
          ]
        },

        "y": {
          "field": "state_code",
          "type": "nominal",
          "sort": [
            "ACT",
            "NSW",
            "NT",
            "QLD",
            "SA",
            "TAS",
            "VIC",
            "WA"
          ]
        },

        "text": {
          "field": "Participation",
          "type": "quantitative",
          "format": ".1f"
        },

        "color": {
          "condition": {
            "test": "datum.Participation >= 35",
            "value": "#FFFFFF"
          },
          "value": "#222222"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Arial",

    "legend": {
      "orient": "right"
    }
  }
}