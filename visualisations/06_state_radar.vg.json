{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "transparent",

  "title": {
    "text": "Different States, Different Outdoor Profiles",
    "subtitle": "Participation rates across eight outdoor activities, Australia, 2025",
    "anchor": "start",
    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,
    "offset": 16
  },

  "data": {
    "url": "../data/state_activity_participation.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Walking (Recreational)": "number",
        "Bush walking": "number",
        "Running/jogging": "number",
        "Swimming": "number",
        "Cycling": "number",
        "Golf": "number",
        "Surfing": "number",
        "Canoeing/Kayaking": "number"
      }
    }
  },

  "transform": [
    {
      "fold": [
        "Walking (Recreational)",
        "Bush walking",
        "Running/jogging",
        "Swimming",
        "Cycling",
        "Golf",
        "Surfing",
        "Canoeing/Kayaking"
      ],
      "as": [
        "Activity",
        "Participation"
      ]
    },

    {
      "calculate": "datum.Activity == 'Walking (Recreational)' ? 'Walking' : datum.Activity == 'Running/jogging' ? 'Running' : datum.Activity == 'Canoeing/Kayaking' ? 'Kayaking' : datum.Activity",
      "as": "ActivityLabel"
    },

    {
      "calculate": "datum.Activity == 'Walking (Recreational)' ? 0 : datum.Activity == 'Bush walking' ? 1 : datum.Activity == 'Running/jogging' ? 2 : datum.Activity == 'Swimming' ? 3 : datum.Activity == 'Cycling' ? 4 : datum.Activity == 'Golf' ? 5 : datum.Activity == 'Surfing' ? 6 : 7",
      "as": "ActivityOrder"
    },

    {
      "calculate": "datum.ActivityOrder * PI / 4 - PI / 2",
      "as": "Angle"
    },

    {
      "calculate": "datum.Participation / 60",
      "as": "Radius"
    },

    {
      "calculate": "datum.Radius * cos(datum.Angle)",
      "as": "RadarX"
    },

    {
      "calculate": "datum.Radius * sin(datum.Angle)",
      "as": "RadarY"
    },

    {
      "calculate": "1.24 * cos(datum.Angle)",
      "as": "LabelX"
    },

    {
      "calculate": "1.24 * sin(datum.Angle)",
      "as": "LabelY"
    },

    {
      "calculate": "datum.ActivityLabel + '  ' + format(datum.Participation, '.1f') + '%'",
      "as": "ActivityValueLabel"
    }
  ],

  "facet": {
    "field": "state_code",
    "type": "nominal",

    "sort": [
      "ACT",
      "NSW",
      "NT",
      "QLD",
      "SA",
      "TAS",
      "VIC",
      "WA"
    ],

    "header": {
      "title": null,
      "labelFont": "Source Sans 3",
      "labelFontSize": 16,
      "labelFontWeight": 700,
      "labelColor": "#244B36",
      "labelPadding": 14
    }
  },

  "columns": 4,

