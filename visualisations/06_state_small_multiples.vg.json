{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "#FFFFFF",

  "title": {
    "text": "Different Activities, Different Places",
    "subtitle": "Participation rates (%) across Australian states and territories",
    "anchor": "start",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 10,
    "offset": 10
  },

  "data": {
    "url": "../data/australia_states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "../data/state_activity_participation.csv",
          "format": {
            "type": "csv",
            "parse": {
              "Walking (Recreational)": "number",
              "Bush walking": "number",
              "Running/jogging": "number",
              "Swimming": "number",
              "Cycling": "number",
              "Golf": "number",
              "Surfing": "number",
              "Canoeing/Kayaking": "number"
            }
          }
        },
        "key": "state",
        "fields": [
          "state",
          "state_code",
          "Walking (Recreational)",
          "Bush walking",
          "Running/jogging",
          "Swimming",
          "Cycling",
          "Golf",
          "Surfing",
          "Canoeing/Kayaking"
        ]
      }
    },

    {
      "fold": [
        "Walking (Recreational)",
        "Bush walking",
        "Running/jogging",
        "Swimming",
        "Cycling",
        "Golf",
        "Surfing",
        "Canoeing/Kayaking"
      ],
      "as": [
        "Activity",
        "Participation"
      ]
    },

    {
      "calculate": "datum.Activity == 'Walking (Recreational)' ? 'Walking' : datum.Activity == 'Running/jogging' ? 'Running' : datum.Activity == 'Canoeing/Kayaking' ? 'Canoeing / Kayaking' : datum.Activity",
      "as": "ActivityLabel"
    }
  ],

  "facet": {
    "field": "ActivityLabel",
    "type": "nominal",
    "sort": [
      "Walking",
      "Bush walking",
      "Running",
      "Swimming",
      "Cycling",
      "Golf",
      "Surfing",
      "Canoeing / Kayaking"
    ],
    "header": {
      "title": null,
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelColor": "#333333",
      "labelPadding": 2
    }
  },

  "columns": 2,

  "spec": {
    "width": 350,
    "height": 190,

    "projection": {
      "type": "mercator",
      "center": [
        134,
        -28
      ],
      "scale": 220,
      "translate": [
        175,
        92
      ]
    },

    "mark": {
      "type": "geoshape",
      "stroke": "#FFFFFF",
      "strokeWidth": 1
    },

    "encoding": {
      "color": {
        "field": "Participation",
        "type": "quantitative",
        "title": "Participation (%)",
        "scale": {
          "domain": [
            0,
            60
          ],
          "range": [
            "#F3F6EE",
            "#DDE8D4",
            "#B7D1AD",
            "#82AF7C",
            "#4F8A5B",
            "#245C38"
          ]
        },
        "legend": {
          "orient": "bottom",
          "direction": "horizontal",
          "gradientLength": 300,
          "gradientThickness": 12,
          "titleFontSize": 11,
          "titleFontWeight": "bold",
          "titleColor": "#444444",
          "labelFontSize": 10,
          "labelColor": "#666666",
          "values": [
            0,
            10,
            20,
            30,
            40,
            50,
            60
          ]
        }
      },

      "tooltip": [
        {
          "field": "state",
          "type": "nominal",
          "title": "State / Territory"
        },
        {
          "field": "Activity",
          "type": "nominal",
          "title": "Activity"
        },
        {
          "field": "Participation",
          "type": "quantitative",
          "title": "Participation rate (%)",
          "format": ".1f"
        }
      ]
    }
  },

  "resolve": {
    "scale": {
      "color": "shared"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },

    "facet": {
      "spacing": 14
    },

    "font": "Arial",

    "legend": {
      "labelColor": "#555555",
      "titleColor": "#444444"
    }
  }
}