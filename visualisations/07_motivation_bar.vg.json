{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 520,

  "background": "transparent",

  "padding": {
    "left": 0,
    "right": 60,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "Why Do Australians Get Active?",
    "subtitle": "Motivations for sport and physical activity participation among Australian adults, 2025",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35
  },

  "data": {
    "url": "../data/motivation_participation.csv"
  },

  "transform": [
    {
      "calculate": "datum.motivation === 'To be outdoors / to enjoy nature' ? 'Outdoor motivation' : 'Other motivations'",
      "as": "motivation_type"
    },
    {
      "calculate": "datum.motivation === 'Physical health or fitness' ? 'Health & fitness' : datum.motivation === 'Fun/enjoyment' ? 'Enjoyment' : datum.motivation === 'To lose weight / keep weight off / tone' ? 'Weight management' : datum.motivation === 'To be outdoors / to enjoy nature' ? 'Enjoying nature' : datum.motivation === 'Social reasons' ? 'Social' : datum.motivation === 'Psychological / mental health / therapy' ? 'Mental health' : datum.motivation === 'Sense of achievement' ? 'Achievement' : datum.motivation === 'Hobby' ? 'Hobby' : datum.motivation === 'Training purposes' ? 'Training' : datum.motivation === 'Walk the dog' ? 'Dog walking' : datum.motivation === 'Learn a new skill' ? 'Learning a skill' : datum.motivation === 'Performance or competition' ? 'Competition' : datum.motivation === 'Way of getting around' ? 'Transport' : datum.motivation",
      "as": "motivation_label"
    }
  ],

  "encoding": {
    "y": {
      "field": "motivation_label",
      "type": "nominal",
      "title": null,

      "sort": [
        "Health & fitness",
        "Enjoyment",
        "Weight management",
        "Enjoying nature",
        "Social",
        "Mental health",
        "Achievement",
        "Hobby",
        "Training",
        "Dog walking",
        "Learning a skill",
        "Competition",
        "Transport"
      ],

      "axis": {
        "labelLimit": 170,
        "labelPadding": 8,

        "labelFont": "Source Sans 3",
        "labelFontSize": 13,
        "labelColor": "#444444",

        "ticks": false,
        "domain": false
      }
    },

    "x": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Adults reporting motivation (%)",

      "scale": {
        "domain": [0, 70]
      },

      "axis": {
        "grid": true,
        "gridColor": "#E5E3DC",
        "gridWidth": 1,

        "values": [
          0,
          10,
          20,
          30,
          40,
          50,
          60,
          70
        ],

        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#555555",

        "titleFont": "Source Sans 3",
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "titleColor": "#333333",
        "titlePadding": 12,

        "domainColor": "#999999",
        "tickColor": "#999999"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 20,
        "cornerRadiusEnd": 3
      },

      "encoding": {
        "color": {
          "field": "motivation_type",
          "type": "nominal",

          "scale": {
            "domain": [
              "Outdoor motivation",
              "Other motivations"
            ],

            "range": [
              "#244B36",
              "#B8C8B8"
            ]
          },

          "legend": null
        },

        "tooltip": [
          {
            "field": "motivation",
            "type": "nominal",
            "title": "Motivation"
          },
          {
            "field": "participation_rate",
            "type": "quantitative",
            "title": "Adults (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.motivation === 'To be outdoors / to enjoy nature'"
        },
        {
          "calculate": "format(datum.participation_rate, '.1f') + '%  —  Nature motivates more than half'",
          "as": "annotation"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,

        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#244B36"
      },

      "encoding": {
        "text": {
          "field": "annotation"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3",

    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  }
}