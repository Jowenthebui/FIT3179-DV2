{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 540,
  "background": "transparent",

  "padding": {
    "left": 0,
    "right": 30,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "Australia's Wild Places",
    "subtitle": "Explore the 30 largest national parks by area, CAPAD 2024",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35,
    "dy": -10
  },

  "projection": {
    "type": "mercator"
  },

  "params": [
    {
      "name": "StateSelection",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "Filter by state: ",
        "options": [
          "All",
          "WA",
          "SA",
          "NT",
          "QLD",
          "NSW",
          "VIC",
          "TAS",
          "ACT"
        ]
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "../data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#F3F1E9",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      }
    },

    {
      "data": {
        "url": "../data/national_parks_top30_capad2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "AREA_KM2": "number",
            "LONGITUDE": "number",
            "LATITUDE": "number",
            "RANK": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "StateSelection == 'All' || datum.STATE == StateSelection"
        }
      ],

      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],

      "mark": {
        "type": "circle",
        "stroke": "#FFFFFF"
      },

      "encoding": {
        "longitude": {
          "field": "LONGITUDE",
          "type": "quantitative"
        },

        "latitude": {
          "field": "LATITUDE",
          "type": "quantitative"
        },

        "size": {
          "field": "AREA_KM2",
          "type": "quantitative",
          "title": "Park area (km²)",

          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              36054
            ],
            "range": [
              45,
              1800
            ]
          },

          "legend": {
            "title": "Park area (km²)",
            "orient": "right",

            "values": [
              5000,
              15000,
              30000
            ],

            "format": ",.0f",

            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 700,
            "titleColor": "#333333",
            "titlePadding": 14,

            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#555555",
            "labelOffset": 12,

            "symbolFillColor": "#4F7D5B",
            "symbolStrokeColor": "#FFFFFF",
            "symbolOpacity": 0.9,

            "offset": 30
          }
        },

        "color": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#244B36"
          },
          "value": "#4F7D5B"
        },

        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0.84
        },

        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 2.5
          },
          "value": 0.8
        },

        "order": {
          "field": "AREA_KM2",
          "type": "quantitative",
          "sort": "descending"
        },

        "tooltip": [
          {
            "field": "NAME",
            "type": "nominal",
            "title": "National Park"
          },
          {
            "field": "STATE",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "AREA_KM2",
            "type": "quantitative",
            "title": "Area (km²)",
            "format": ",.0f"
          },
          {
            "field": "RANK",
            "type": "quantitative",
            "title": "Size Rank",
            "format": ".0f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3",

    "legend": {
      "orient": "right",
      "direction": "vertical",
      "padding": 10,

      "labelFont": "Source Sans 3",
      "labelFontSize": 11,

      "titleFont": "Source Sans 3",
      "titleFontSize": 12
    }
  }
}