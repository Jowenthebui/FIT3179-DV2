{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 620,
  "background": "transparent",

  "padding": {
    "left": 0,
    "right": 70,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "Australia's Largest National Parks",
    "subtitle": "Explore the largest national parks by area, CAPAD 2024",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35,
    "dy": -10
  },

  "data": {
    "url": "../data/national_parks_top30_capad2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "AREA_KM2": "number"
      }
    }
  },

  "params": [
    {
      "name": "TopN",
      "value": 10,
      "bind": {
        "input": "select",
        "name": "Show parks: ",
        "options": [10, 20, 30],
        "labels": [
          "Top 10",
          "Top 20",
          "Top 30"
        ]
      }
    }
  ],

  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "ParkRank"
        }
      ],
      "sort": [
        {
          "field": "AREA_KM2",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.ParkRank <= TopN"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },

      "encoding": {
        "y": {
          "field": "NAME",
          "type": "nominal",

          "sort": {
            "field": "AREA_KM2",
            "op": "max",
            "order": "descending"
          },

          "title": null,

          "axis": {
            "labelFont": "Source Sans 3",
            "labelFontSize": 12,
            "labelColor": "#444444",

            "labelLimit": 320,
            "labelPadding": 10,

            "ticks": false,
            "domain": false
          }
        },

        "x": {
          "field": "AREA_KM2",
          "type": "quantitative",
          "title": "Park area (km²)",

          "scale": {
            "domain": [0, 38000]
          },

          "axis": {
            "titleFont": "Source Sans 3",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#333333",
            "titlePadding": 12,

            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#555555",

            "format": ",.0f",

            "grid": true,
            "gridColor": "#E5E3DC",
            "gridWidth": 1,

            "domain": false,
            "ticks": false
          }
        },

        "size": {
          "condition": [
            {
              "test": "TopN == 10",
              "value": 35
            },
            {
              "test": "TopN == 20",
              "value": 22
            }
          ],
          "value": 10
        },

        "color": {
          "condition": {
            "test": "datum.ParkRank == 1",
            "value": "#244B36"
          },
          "value": "#A8C7A2"
        },

        "opacity": {
          "value": 0.9
        },

        "tooltip": [
          {
            "field": "ParkRank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "NAME",
            "type": "nominal",
            "title": "National Park"
          },
          {
            "field": "STATE",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "AREA_KM2",
            "type": "quantitative",
            "title": "Area (km²)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.ParkRank == 1"
        },
        {
          "calculate": "format(datum.AREA_KM2, ',.0f') + ' km²'",
          "as": "annotation"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,

        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#244B36"
      },

      "encoding": {
        "y": {
          "field": "NAME",
          "type": "nominal",

          "sort": {
            "field": "AREA_KM2",
            "op": "max",
            "order": "descending"
          },

          "title": null
        },

        "x": {
          "field": "AREA_KM2",
          "type": "quantitative"
        },

        "text": {
          "field": "annotation"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3",

    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  }
}