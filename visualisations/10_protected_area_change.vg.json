  "title": {
    "text": "Australia's Protected Landscape Over Time",
    "subtitle": "CAPAD snapshots show the changing footprint of terrestrial protected areas, 2008–2024",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35
  },

  "vconcat": [
    {
      "hconcat": [
        {
          "width": 330,
          "height": 250,

          "title": {
            "text": "2008",
            "font": "Source Sans 3",
            "fontSize": 16,
            "fontWeight": 700,
            "color": "#244B36",
            "anchor": "middle",
            "offset": 8
          },

          "projection": {
            "type": "mercator"
          },

          "layer": [
            {
              "data": {
                "url": "../data/australia_states.geojson",
                "format": {
                  "type": "json",
                  "property": "features"
                }
              },

              "mark": {
                "type": "geoshape",
                "fill": "#F3F1E9",
                "stroke": "#C9C8C2",
                "strokeWidth": 0.8
              }
            },

            {
              "data": {
                "url": "../data/capad_history/capad2008_australia.geojson",
                "format": {
                  "type": "json",
                  "property": "geometries"
                }
              },

              "transform": [
                {
                  "calculate": "'2008'",
                  "as": "Year"
                },
                {
                  "calculate": "'Terrestrial protected area'",
                  "as": "AreaType"
                }
              ],

              "params": [
                {
                  "name": "hover2008",
                  "select": {
                    "type": "point",
                    "on": "mouseover",
                    "clear": "mouseout"
                  }
                }
              ],

              "mark": {
                "type": "geoshape"
              },

              "encoding": {
                "color": {
                  "condition": {
                    "param": "hover2008",
                    "empty": false,
                    "value": "#244B36"
                  },
                  "value": "#4F7D5B"
                },

                "opacity": {
                  "condition": {
                    "param": "hover2008",
                    "empty": false,
                    "value": 1
                  },
                  "value": 0.9
                },

                "tooltip": [
                  {
                    "field": "Year",
                    "type": "nominal",
                    "title": "CAPAD year"
                  },
                  {
                    "field": "AreaType",
                    "type": "nominal",
                    "title": "Area"
                  }
                ]
              }
            }
          ]
        },

