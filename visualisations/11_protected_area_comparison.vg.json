
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "background": "transparent",
  "padding": {
    "left": 0,
    "right": 30,
    "top": 10,
    "bottom": 10
  },
  "title": {
    "text": "How Has Protected Coverage Changed Across Australia?",
    "subtitle": "Protected terrestrial area by state and territory, 2008 vs 2024",
    "anchor": "start",
    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,
    "offset": 16
  },
  "data": {
    "url": "data/protected_area_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "2008": "number",
        "2024": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum['2024'] - datum['2008']",
      "as": "Change"
    },
    {
      "fold": ["2008", "2024"],
      "as": ["Year", "Protected"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "size": 18
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Change",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFont": "Source Sans 3",
            "labelFontSize": 14,
            "labelColor": "#333333",
            "labelLimit": 230,
            "labelPadding": 12,
            "ticks": false,
            "domain": false
          }
        },
        "yOffset": {
          "field": "Year",
          "sort": ["2008", "2024"]
        },
        "x": {
          "field": "Protected",
          "type": "quantitative",
          "title": "Protected terrestrial area (%)",
          "scale": {
            "domain": [0, 60],
            "nice": false
          },
          "axis": {
            "titleFont": "Source Sans 3",
            "titleFontSize": 14,
            "titleFontWeight": 600,
            "titleColor": "#333333",
            "titlePadding": 14,
            "labelFont": "Source Sans 3",
            "labelFontSize": 13,
            "labelColor": "#555555",
            "labelExpr": "datum.value + '%'",
            "tickCount": 11,
            "grid": true,
            "gridColor": "#E5E3DC",
            "gridWidth": 1,
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "Year",
          "type": "nominal",
          "scale": {
            "domain": ["2008", "2024"],
            "range": ["#B8CEB6", "#3F704D"]
          },
          "legend": {
            "title": null,
            "orient": "right",
            "direction": "vertical",
            "labelFont": "Source Sans 3",
            "labelFontSize": 14,
            "labelColor": "#333333",
            "symbolType": "square",
            "symbolSize": 180,
            "offset": 20,
            "padding": 10,
            "rowPadding": 10
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Protected",
            "type": "quantitative",
            "title": "Protected area (%)",
            "format": ".1f"
          },
          {
            "field": "Change",
            "type": "quantitative",
            "title": "2008–2024 change (pp)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Western Australia' && datum.Year == '2024'"
        },
        {
          "calculate": "'+' + format(datum.Change, '.1f') + ' pp'",
          "as": "annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "font": "Source Sans 3",
        "fontSize": 16,
        "fontWeight": 700,
        "color": "#244B36"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "Change",
            "op": "max",
            "order": "descending"
          }
        },
        "yOffset": {
          "field": "Year",
          "sort": ["2008", "2024"]
        },
        "x": {
          "field": "Protected",
          "type": "quantitative"
        },
        "text": {
          "field": "annotation",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "title": {
      "font": "Source Sans 3"
    }
  }
}
