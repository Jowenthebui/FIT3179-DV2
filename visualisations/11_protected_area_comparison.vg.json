{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 400,
  "background": "#FFFFFF",

  "title": {
    "text": "How Has Protected Coverage Changed Across Australia?",
    "subtitle": "Protected terrestrial area by state and territory, 2008 vs 2024",
    "anchor": "start",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8
  },

  "data": {
    "url": "../data/protected_area_by_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "2008": "number",
        "2024": "number"
      }
    }
  },

  "transform": [
    {
      "calculate": "datum['2024'] - datum['2008']",
      "as": "Change"
    },
    {
      "fold": [
        "2008",
        "2024"
      ],
      "as": [
        "Year",
        "Protected"
      ]
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },

      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Change",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 12,
            "labelColor": "#333333",
            "labelLimit": 190,
            "labelPadding": 8,
            "ticks": false,
            "domain": false
          }
        },

        "yOffset": {
          "field": "Year"
        },

        "x": {
          "field": "Protected",
          "type": "quantitative",
          "title": "Protected terrestrial area (%)",
          "scale": {
            "domain": [
              0,
              60
            ]
          },
          "axis": {
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titleColor": "#555555",
            "titlePadding": 12,
            "labelFontSize": 11,
            "labelColor": "#666666",
            "labelExpr": "datum.value + '%'",
            "grid": true,
            "gridColor": "#E8E8E8",
            "gridWidth": 1,
            "domain": false,
            "ticks": false
          }
        },

        "color": {
          "field": "Year",
          "type": "nominal",
          "scale": {
            "domain": [
              "2008",
              "2024"
            ],
            "range": [
              "#B8CEB6",
              "#3F704D"
            ]
          },
          "legend": {
            "title": null,
            "orient": "right",
            "direction": "vertical",
            "labelFontSize": 11,
            "labelColor": "#333333",
            "symbolType": "square",
            "symbolSize": 120,
            "offset": 20
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Protected",
            "type": "quantitative",
            "title": "Protected area (%)",
            "format": ".1f"
          },
          {
            "field": "Change",
            "type": "quantitative",
            "title": "2008–2024 change",
            "format": "+.1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state == 'Western Australia' && datum.Year == '2024'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#2E6B3E"
      },

      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "Change",
            "op": "max",
            "order": "descending"
          }
        },

        "yOffset": {
          "field": "Year"
        },

        "x": {
          "field": "Protected",
          "type": "quantitative"
        },

        "text": {
          "value": "Largest increase: +16.7 percentage points"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Arial",

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}