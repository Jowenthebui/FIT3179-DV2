{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 400,

  "background": "transparent",

  "padding": {
    "left": 0,
    "right": 40,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "Sports & Recreation Tourism Has Rebounded",
    "subtitle": "Tourism output from sports and recreation services, Australia, 2016–17 to 2023–24",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16,
    "dx": -35,
    "dy": -10
  },

  "data": {
    "url": "../data/sports_recreation_tourism_output.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tourism_output_million": "number"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#4F7D5B",

        "point": {
          "filled": true,
          "fill": "#FBFAF4",
          "stroke": "#4F7D5B",
          "strokeWidth": 2,
          "size": 75
        }
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,

          "sort": [
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ],

          "axis": {
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#555555",
            "labelAngle": 0,
            "labelPadding": 10,
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "tourism_output_million",
          "type": "quantitative",
          "title": "Tourism output ($ billion)",

          "scale": {
            "domain": [
              0,
              5500
            ]
          },

          "axis": {
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titleColor": "#555555",
            "titlePadding": 14,

            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#666666",
            "labelExpr": "'$' + format(datum.value / 1000, '.1f') + 'b'",

            "grid": true,
            "gridColor": "#E5E3DC",
            "gridWidth": 1,

            "ticks": false,
            "domain": false
          }
        },

        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "tourism_output_million",
            "type": "quantitative",
            "title": "Tourism output ($m)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2020-21'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "color": "#B26A4A"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",

          "sort": [
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ]
        },

        "y": {
          "field": "tourism_output_million",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "tourism_output_million",
            "type": "quantitative",
            "title": "Tourism output ($m)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2020-21'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "dy": 18,

        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#8A523A"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",

          "sort": [
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ]
        },

        "y": {
          "field": "tourism_output_million",
          "type": "quantitative"
        },

        "text": {
          "value": "Pandemic low: $2.36b"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2023-24'"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 125,
        "color": "#244B36"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",

          "sort": [
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ]
        },

        "y": {
          "field": "tourism_output_million",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "tourism_output_million",
            "type": "quantitative",
            "title": "Tourism output ($m)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2023-24'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -10,
        "dy": -14,

        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#244B36"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",

          "sort": [
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ]
        },

        "y": {
          "field": "tourism_output_million",
          "type": "quantitative"
        },

        "text": {
          "value": "2023–24: $5.06b"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3",

    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },

    "title": {
      "font": "Source Sans 3"
    }
  }
}