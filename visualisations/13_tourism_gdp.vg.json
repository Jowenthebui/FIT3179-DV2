{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 400,

  "background": "transparent",

  "padding": {
    "left": 0,
    "right": 35,
    "top": 5,
    "bottom": 5
  },

  "title": {
    "text": "Two Decades of Australian Tourism",
    "subtitle": "Year-to-year change in tourism GDP at current prices, Australia, 2004–05 to 2023–24",
    "anchor": "start",

    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,

    "offset": 16
  },

  "data": {
    "url": "../data/tourism_gdp.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tourism_gdp_million": "number"
      }
    }
  },

  "transform": [
    {
      "window": [
        {
          "op": "lag",
          "field": "tourism_gdp_million",
          "as": "previous_gdp"
        }
      ],
      "sort": [
        {
          "field": "year",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.previous_gdp == null ? 0 : datum.tourism_gdp_million - datum.previous_gdp",
      "as": "change"
    },
    {
      "calculate": "datum.previous_gdp == null ? 0 : min(datum.previous_gdp, datum.tourism_gdp_million)",
      "as": "bar_start"
    },
    {
      "calculate": "datum.previous_gdp == null ? datum.tourism_gdp_million : max(datum.previous_gdp, datum.tourism_gdp_million)",
      "as": "bar_end"
    },
    {
      "calculate": "datum.previous_gdp == null ? 'Starting point' : datum.change >= 0 ? 'Increase' : 'Decrease'",
      "as": "direction"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 16,
        "cornerRadius": 2
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,

          "sort": [
            "2004-05",
            "2005-06",
            "2006-07",
            "2007-08",
            "2008-09",
            "2009-10",
            "2010-11",
            "2011-12",
            "2012-13",
            "2013-14",
            "2014-15",
            "2015-16",
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ],

          "axis": {
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#555555",
            "labelAngle": 0,
            "labelPadding": 10,

            "labelExpr": "indexof(['2004-05','2008-09','2012-13','2016-17','2020-21','2023-24'], datum.label) >= 0 ? datum.label : ''",

            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "bar_start",
          "type": "quantitative",
          "title": "Tourism GDP ($ billion)",

          "scale": {
            "domain": [
              0,
              80000
            ]
          },

          "axis": {
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titleColor": "#555555",
            "titlePadding": 14,

            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#666666",
            "labelExpr": "'$' + format(datum.value / 1000, '.0f') + 'b'",

            "grid": true,
            "gridColor": "#E5E3DC",
            "gridWidth": 1,

            "ticks": false,
            "domain": false
          }
        },

        "y2": {
          "field": "bar_end"
        },

        "color": {
          "field": "direction",
          "type": "nominal",

          "scale": {
            "domain": [
              "Starting point",
              "Increase",
              "Decrease"
            ],

            "range": [
              "#7A7A72",
              "#4F7D5B",
              "#B26A4A"
            ]
          },

          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",

            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#555555",

            "symbolType": "square",
            "symbolSize": 100,

            "offset": 8
          }
        },

        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "tourism_gdp_million",
            "type": "quantitative",
            "title": "Tourism GDP ($m)",
            "format": ",.0f"
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change from previous year ($m)",
            "format": "+,.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2020-21'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "dy": 12,

        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#8A523A"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",

          "sort": [
            "2004-05",
            "2005-06",
            "2006-07",
            "2007-08",
            "2008-09",
            "2009-10",
            "2010-11",
            "2011-12",
            "2012-13",
            "2013-14",
            "2014-15",
            "2015-16",
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ]
        },

        "y": {
          "field": "bar_start",
          "type": "quantitative"
        },

        "text": {
          "value": [
            "Pandemic impact",
            "$30.9b"
          ]
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2023-24'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -5,
        "dy": -12,

        "font": "Source Sans 3",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#244B36"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",

          "sort": [
            "2004-05",
            "2005-06",
            "2006-07",
            "2007-08",
            "2008-09",
            "2009-10",
            "2010-11",
            "2011-12",
            "2012-13",
            "2013-14",
            "2014-15",
            "2015-16",
            "2016-17",
            "2017-18",
            "2018-19",
            "2019-20",
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24"
          ]
        },

        "y": {
          "field": "bar_end",
          "type": "quantitative"
        },

        "text": {
          "value": "2023–24: $78.1b"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "font": "Source Sans 3",

    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },

    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },

    "title": {
      "font": "Source Sans 3"
    }
  }
}