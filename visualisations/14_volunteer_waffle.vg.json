
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 450,
  "background": "transparent",
  "padding": {
    "left": 10,
    "right": 10,
    "top": 10,
    "bottom": 10
  },
  "title": {
    "text": "Sport Needs More Than Players",
    "subtitle": "Adult volunteering in non-playing sport roles, Australia, 2025",
    "anchor": "start",
    "font": "Source Sans 3",
    "fontSize": 24,
    "fontWeight": 700,
    "color": "#222222",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8,
    "offset": 16
  },
  "data": {
    "sequence": {
      "start": 1,
      "stop": 101,
      "as": "person"
    }
  },
  "transform": [
    {
      "calculate": "(datum.person - 1) % 10",
      "as": "column"
    },
    {
      "calculate": "floor((datum.person - 1) / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.person <= 12 ? 'Volunteer' : 'Other adults'",
      "as": "status"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 650,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.2,
        "paddingOuter": 0.2
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null,
      "scale": {
        "paddingInner": 0.2,
        "paddingOuter": 0.2
      }
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Volunteer",
          "Other adults"
        ],
        "range": [
          "#4F7D5B",
          "#E3E3DE"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "labelFont": "Source Sans 3",
        "labelFontSize": 14,
        "labelColor": "#555555",
        "symbolType": "circle",
        "symbolSize": 180,
        "symbolOffset": 8,
        "columnPadding": 30,
        "offset": 20
      }
    },
    "tooltip": [
      {
        "field": "status",
        "type": "nominal",
        "title": "Representation"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "legend": {
      "labelFont": "Source Sans 3"
    },
    "title": {
      "font": "Source Sans 3"
    }
  }
}
