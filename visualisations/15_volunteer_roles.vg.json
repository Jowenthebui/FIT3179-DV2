{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 620,
  "height": 420,
  "background": "#FFFFFF",

  "title": {
    "text": "How Do Australians Volunteer in Sport?",
    "subtitle": "Adult participation in non-playing volunteer roles, Australia, 2025",
    "anchor": "start",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#222222",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "subtitlePadding": 8
  },

  "data": {
    "url": "../data/volunteer_roles.csv",
    "format": {
      "type": "csv",
      "parse": {
        "participation_rate": "number"
      }
    }
  },

  "transform": [
    {
      "filter": "datum.role != 'Other'"
    },
    {
      "calculate": "datum.role == 'Official' ? 'Referee / Official' : datum.role == 'Coach / instructor / trainer / teacher' ? 'Coach / Instructor' : datum.role == 'General / miscellaneous assistance' ? 'General Assistance' : datum.role == 'Administrator / committee member' ? 'Administrator' : datum.role == 'Team manager / coordinator' ? 'Team Manager' : datum.role == 'Driving team members' ? 'Driver' : datum.role == 'Medical support / health and safety' ? 'Medical / Safety' : datum.role == 'Financial support / helping pay for others' ? 'Financial Support' : datum.role",
      "as": "short_role"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": 24
      },

      "encoding": {
        "y": {
          "field": "short_role",
          "type": "nominal",
          "sort": [
            "Referee / Official",
            "Coach / Instructor",
            "General Assistance",
            "Administrator",
            "Team Manager",
            "Driver",
            "Fundraising",
            "Medical / Safety",
            "Financial Support"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelColor": "#333333",
            "labelPadding": 10,
            "labelLimit": 180,
            "ticks": false,
            "domain": false
          }
        },

        "x": {
          "field": "participation_rate",
          "type": "quantitative",
          "title": "Adult participation rate (%)",
          "scale": {
            "domain": [0, 4.2]
          },
          "axis": {
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titleColor": "#555555",
            "titlePadding": 12,
            "labelFontSize": 11,
            "labelColor": "#666666",
            "format": ".1f",
            "tickCount": 5,
            "grid": true,
            "gridColor": "#E8E8E8",
            "gridWidth": 1,
            "ticks": false,
            "domain": false
          }
        },

        "color": {
          "condition": {
            "test": "datum.short_role == 'Referee / Official'",
            "value": "#3F704D"
          },
          "value": "#8FB294"
        },

        "tooltip": [
          {
            "field": "role",
            "type": "nominal",
            "title": "AusPlay role"
          },
          {
            "field": "participation_rate",
            "type": "quantitative",
            "title": "Adult participation",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.short_role == 'Referee / Official'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#3F704D"
      },

      "encoding": {
        "y": {
          "field": "short_role",
          "type": "nominal",
          "sort": [
            "Referee / Official",
            "Coach / Instructor",
            "General Assistance",
            "Administrator",
            "Team Manager",
            "Driver",
            "Fundraising",
            "Medical / Safety",
            "Financial Support"
          ]
        },

        "x": {
          "field": "participation_rate",
          "type": "quantitative"
        },

        "text": {
          "field": "participation_rate",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}