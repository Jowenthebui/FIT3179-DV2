{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 500,
  "height": 360,

  "title": {
    "text": "Who Gets Outdoors?",
    "subtitle": "Outdoor participation patterns shift across age groups, 2025",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },

  "data": {
    "url": "../data/age_activity_participation.csv"
  },

  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout",
        "fields": [
          "activity",
          "age_group"
        ]
      }
    }
  ],

  "mark": {
    "type": "rect",
    "strokeWidth": 2
  },

  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age Group",
      "sort": [
        "15-17",
        "18-24",
        "25-34",
        "35-44",
        "45-54",
        "55-64",
        "65+"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "titleFontSize": 12,
        "titlePadding": 10
      }
    },

    "y": {
      "field": "activity",
      "type": "nominal",
      "title": null,
      "sort": [
        "Walking (Recreational)",
        "Running/jogging",
        "Bush walking",
        "Swimming",
        "Cycling",
        "Golf",
        "Surfing",
        "Canoeing/Kayaking"
      ],
      "axis": {
        "labelFontSize": 12,
        "labelPadding": 8,
        "ticks": false,
        "domain": false
      }
    },

    "color": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Participation Rate (%)",
      "scale": {
        "scheme": "yellowgreenblue",
        "domain": [0, 66]
      },
      "legend": {
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },

    "stroke": {
      "condition": {
        "param": "hover",
        "value": "#333333"
      },
      "value": "white"
    },

    "tooltip": [
      {
        "field": "activity",
        "type": "nominal",
        "title": "Activity"
      },
      {
        "field": "age_group",
        "type": "ordinal",
        "title": "Age Group"
      },
      {
        "field": "participation_rate",
        "type": "quantitative",
        "title": "Participation Rate (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}